---

import {Image}  from 'astro:assets';
import ContactA from '../../assets/navigation_Images/contacto-a.png'
import ContactB from '../../assets/navigation_Images/contacto-b.png'

const {isActive} = Astro.props;
const imagenMostrar = isActive ? ContactB : ContactA;
---


<style>
    .navigation-contact{
        padding: 0 5px;
    }
</style>

<a href="#" class="navigation-contact">
    <Image src={imagenMostrar} alt="Contacto">
</a>