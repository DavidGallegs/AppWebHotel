---
//Imagenes del Home y Contact
import homeNegra from '../../assets/navigation_Images/homeBlack.png';
import homeMarron from '../../assets/navigation_Images/homeBrowm.png';
import contactoNegra from '../../assets/navigation_Images/contacto-a.png';
import contactoMarron from '../../assets/navigation_Images/contacto-b.png';

// Tus variables:
const imgHomeNegra = homeNegra.src;
const imgHomeMarron = homeMarron.src;
const imgContactoNegra = contactoNegra.src;
const imgContactoMarron = contactoMarron.src;

// 1. Importación correcta según la documentación de auth-astro
import { getSession } from 'auth-astro/server';
import LogoutButton from '../sesiones/LogoutButton.tsx'; 
import '../../styles/navigation.css'; 

// 2. Leemos la sesión pasándole la request de Astro
const session = await getSession(Astro.request);

// 3. (Opcional pero útil para depurar): Haz un console.log para ver si en la terminal sale tu usuario
console.log("Sesión actual:", session ? "Usuario Logueado" : "No logueado");

// ... resto de tu código de import.meta.glob ...
const paginas = Object.values(import.meta.glob('../../md_pages/*.mdx', { eager: true })) as any[];

const enlacesTexto = paginas
    .filter(page => !page.frontmatter.isHome && !page.frontmatter.isContact)
    .sort((a, b) => a.frontmatter.orden - b.frontmatter.orden);

const currentPath = Astro.url.pathname;

// Lógica para saber si estamos en Home o Contacto
const isHome = currentPath === '/';
const isContact = currentPath === '/contacto' || currentPath === '/contacto/';
---

<nav class="navigation">
    <div class="nav-container">
        
        <!-- Enlaces Fijos (Iconos) -->
        <div class="nav-icons">
            <a href="/" class="icon-link">
                <img src={isHome ? imgHomeMarron : imgHomeNegra} alt="Inicio" class="nav-icon-img" />
            </a>
            <a href="/contacto" class="icon-link">
                <img src={isContact ? imgContactoMarron : imgContactoNegra} alt="Contacto" class="nav-icon-img" />
            </a>
        </div>

        <!-- Botón Hamburguesa (Oculto en PC, visible en móvil) -->
        <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- Contenedor colapsable: Agrupa texto y sesión -->
        <div class="nav-menu" id="nav-menu">
            <!-- Enlaces Dinámicos (.mdx) -->
            <ul class="nav-links">
                {enlacesTexto.map((page) => {
                    const nombreArchivo = page.file.split('/').pop()!.replace('.mdx', '');
                    const ruta = `/${nombreArchivo}`;
                    const isActive = currentPath === ruta || currentPath === `${ruta}/`;

                    return (
                        <li>
                            <a href={ruta} class={`nav-item ${isActive ? 'active' : ''}`}>
                                {page.frontmatter.nombreEnlace}
                            </a>
                        </li>
                    );
                })}
            </ul>

            <!-- Zona de Sesión -->
            <ul class="nav-auth">
                {session ? (
                    <>
                        <li><a href="/reserva" class={`nav-item ${currentPath === '/reserva' ? 'active' : ''}`}>Reservar</a></li>
                        <li><a href="/dashboard" class={`nav-item ${currentPath === '/dashboard' ? 'active' : ''}`}>Dashboard</a></li>
                        <li><LogoutButton client:load /></li>
                    </>
                ) : (
                    <>
                        <li><a href="/login" class="nav-item auth-btn">Iniciar Sesión</a></li>
                        <li><a href="/join" class="nav-item auth-btn">Registrarse</a></li>
                    </>
                )}
            </ul>
        </div>
    </div>
</nav>

<!-- Lógica del Menú Hamburguesa -->
<script>
    const btn = document.getElementById('hamburger-btn');
    const menu = document.getElementById('nav-menu');

    btn?.addEventListener('click', () => {
        // Añade o quita la clase 'open' para mostrar/ocultar
        menu?.classList.toggle('open');
        // Opcional: animación para el botón
        btn.classList.toggle('is-active');
    });

</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.navigation');
    
    if (!nav) return; 
    const checkScroll = () => {
      if (window.scrollY > 120) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    checkScroll();
    window.addEventListener('scroll', checkScroll);
  });
</script>