---
import {Image}  from 'astro:assets';
import facebook from '../../assets/navigation_Images/facebook.png'
import menuIcon from '../../assets/navigation_Images/menu.png'
import logoDark from '../../assets/navigation_Images/logo_dark.png'

import ContactNavigation from "./ContactNavigation.astro";
import ImageNavigation from "./HomeNavigation.astro"
import LinkNavigation from "./LinkNavigation.astro"


const {isHome,isContact} = Astro.props;
---

<nav class="navigation">
    <div class="navigation-container-menu">
        <button id="menu-toggle-btn" class="navigation-btn">
            <Image src={menuIcon} alt="menu Icon"/>
        </button>

        <Image src={logoDark} alt="Logo Hotel" class="navigation-logoDark"/>
    </div>


    <div class="navigation-container">
        <div class="navigation_url">
            <ImageNavigation isActive={isHome}/>
            <ContactNavigation isActive={isContact}/>
            <a href="http://www.facebook.com/quintanaltaranes" class="navigation-facebook" target="_blank">
                <Image src={facebook} alt="Home"/>
            </a>
        </div>
        <ul class="navigation-ul">
            <LinkNavigation site="Situacion"/>
            <LinkNavigation site="Taranes"/>
            <LinkNavigation site="Ponga"/>
            <LinkNavigation site="Hotel Rural"/>
            <LinkNavigation site="Bar"/>
            <LinkNavigation site="Fotos"/>
            <LinkNavigation site="Comentarios"/>
        </ul>
    </div>
        
</nav>

<style>
    .navigation-container{
        display: flex;
        height: 50px;
        justify-content: center;
        align-items: center;
        padding: 5px;
        margin-top: 100px;
    }

    .navigation-ul{
        list-style: none;
        padding: 0 0 0 10px;
    }

    .navigation-container-menu{
        display: none;
    }

    @media (max-width: 768px){

        .navigation{
            position: sticky;
            top:0;
            width: 100%;
        }

        .navigation-container{
            display: none;
        }

        .navigation-container-menu{
            display: flex;
            align-items: center;
            width: 100%;
            background-color: #0c0c0c ; 
            padding: 10px 15px;
        }

        .navigation-btn{
            cursor: pointer;
            background: transparent;
            border: none;
            padding: 0;
        }

        .navigation-logoDark{
            margin-left: auto;
        }

        .navigation-container.show-menu {
            display: block; 
            text-align: center;
            background-color: #0c0c0c;
            margin-top: 0; 
            padding: 0;
        }

        .navigation-ul{
            background-color: #333;
            display: flex;
            flex-direction: column; 
            justify-content: center;
            align-content: center;
            padding: 0;
        }
    }
</style>

<script>
    const menuBtn = document.getElementById('menu-toggle-btn');
    const menuContainer = document.querySelector('.navigation-container');

    if (menuBtn && menuContainer) {
        menuBtn.addEventListener('click', () => {
            menuContainer.classList.toggle('show-menu');
        });
    }
</script>