---
const {site} = Astro.props
---

<style>
    
    .navigation-li{
        display: inline-block;
        margin: 0 7px;
    }
    .navigation-link{
        text-decoration: dashed;
        color: #000;
        
    }

    .navigation-link:hover{
        color: #cc530e;
    }

    .navigation-link:active{
        color: #77330e;
    }

    @media (max-width: 768px){

        .navigation-link{
            
            display: block;
            color: #fff;
            font-size: 1.2rem; 
            padding: 10px 0 10px 20px;
            
        }

        .navigation-li{
            border-top: 1px #444  solid;
            text-align: left;
            margin: 0;
            
        }
    }

</style>

<li class="navigation-li"><a href={`/${site}`} class="navigation-link">{site}</a></li>