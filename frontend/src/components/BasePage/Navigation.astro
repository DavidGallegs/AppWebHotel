---
// Importación de imágenes dinámicas para cambiar el color según la página
import homeNegra from '../../assets/navigation_Images/homeBlack.png';
import homeMarron from '../../assets/navigation_Images/homeBrowm.png';
import contactoNegra from '../../assets/navigation_Images/contacto-a.png';
import contactoMarron from '../../assets/navigation_Images/contacto-b.png';

const imgHomeNegra = homeNegra.src;
const imgHomeMarron = homeMarron.src;
const imgContactoNegra = contactoNegra.src;
const imgContactoMarron = contactoMarron.src;

// Sistema de autenticación de Astro
import { getSession } from 'auth-astro/server';
import LogoutButton from '../sesiones/LogoutButton.tsx'; 
import '../../styles/navigation.css'; 

/* * LECTURA DE SESIÓN
 * Astro revisa las cookies del navegador antes de renderizar el HTML.
 * Si hay sesión, el menú mostrará "Dashboard". Si no, "Iniciar Sesión".
 */
const session = await getSession(Astro.request);

/* * GENERACIÓN DINÁMICA DE ENLACES (Magia de Vite/Astro)
 * Busca automáticamente todos los archivos .mdx en tu carpeta md_pages.
 * Luego filtra los que no son Home ni Contacto, y los ordena según el número que pusiste en su frontmatter.
 * ¡Esto te evita tener que añadir enlaces al menú a mano cada vez que creas una página!
 */
const paginas = Object.values(import.meta.glob('../../md_pages/*.mdx', { eager: true })) as any[];

const enlacesTexto = paginas
    .filter(page => !page.frontmatter.isHome && !page.frontmatter.isContact)
    .sort((a, b) => a.frontmatter.orden - b.frontmatter.orden);

const currentPath = Astro.url.pathname;

// Banderas lógicas para pintar los iconos correctos
const isHome = currentPath === '/';
const isContact = currentPath === '/contacto' || currentPath === '/contacto/';
---

<nav class="navigation" aria-label="Navegación principal">
    <div class="nav-container">
        
        {/* Iconos fijos a la izquierda */}
        <div class="nav-icons">
            <a href="/" class="icon-link" aria-label="Ir a la página de inicio">
                <img src={isHome ? imgHomeMarron : imgHomeNegra} alt="" class="nav-icon-img" aria-hidden="true" />
            </a>
            <a href="/contacto" class="icon-link" aria-label="Ir a la página de contacto">
                <img src={isContact ? imgContactoMarron : imgContactoNegra} alt="" class="nav-icon-img" aria-hidden="true" />
            </a>
        </div>

        {/* * ACCESIBILIDAD: El botón hamburguesa necesita saber a qué controla (aria-controls)
          * y si está abierto o cerrado (aria-expanded).
          */}
        <button 
            class="hamburger" 
            id="hamburger-btn" 
            aria-label="Abrir menú de navegación" 
            aria-expanded="false" 
            aria-controls="nav-menu"
        >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>

        <div class="nav-menu" id="nav-menu">
         
            <ul class="nav-links">
                {/* Mapeo dinámico de las páginas MDX */}
                {enlacesTexto.map((page) => {
                    const nombreArchivo = page.file.split('/').pop()!.replace('.mdx', '');
                    const ruta = `/${nombreArchivo}`;
                    const isActive = currentPath === ruta || currentPath === `${ruta}/`;

                    return (
                        <li>
                            <a 
                                href={ruta} 
                                class={`nav-item ${isActive ? 'active' : ''}`}
                                aria-current={isActive ? 'page' : undefined}
                            >
                                {page.frontmatter.nombreEnlace}
                            </a>
                        </li>
                    );
                })}
  
                <li>
                    <a 
                        href="/fotos" 
                        class={`nav-item ${currentPath === '/fotos' || currentPath === '/fotos/' ? 'active' : ''}`}
                        aria-current={currentPath.startsWith('/fotos') ? 'page' : undefined}
                    >
                        Fotos
                    </a>
                </li>
            </ul>

            {/* Zona de usuario condicional */}
            <ul class="nav-auth">
                {session ? (
                    <>
                        <li><a href="/reserva" class={`nav-item ${currentPath === '/reserva' ? 'active' : ''}`}>Reservar</a></li>
                        <li><a href="/dashboard" class={`nav-item ${currentPath === '/dashboard' ? 'active' : ''}`}>Dashboard</a></li>
                        <li><LogoutButton client:load /></li>
                    </>
                ) : (
                    <>
                        <li><a href="/login" class="nav-item auth-btn">Iniciar Sesión</a></li>
                        <li><a href="/join" class="nav-item auth-btn">Registrarse</a></li>
                    </>
                )}
            </ul>
        </div>
    </div>
</nav>

<script>
    // LÓGICA DEL MENÚ MÓVIL
    const btn = document.getElementById('hamburger-btn');
    const menu = document.getElementById('nav-menu');

    btn?.addEventListener('click', () => {
        // Accesibilidad: Alternamos el estado de aria-expanded para los lectores de pantalla
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isExpanded));
        
        // Alternamos las clases visuales
        menu?.classList.toggle('open');
        btn.classList.toggle('is-active');
    });
</script>

<script>
  // LÓGICA DE NAVEGACIÓN FLOTANTE (Scroll)
  // Añade una clase cuando el usuario baja la página para cambiar el fondo o tamaño del menú
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.navigation');
    
    if (!nav) return; 
    
    const checkScroll = () => {
      if (window.scrollY > 120) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    
    checkScroll();
    window.addEventListener('scroll', checkScroll);
  });
</script>