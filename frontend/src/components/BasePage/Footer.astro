<style>
    /* =========================================
       1. CLASES DE UTILIDAD Y ACCESIBILIDAD
       ========================================= */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .footer-strongB {
        color: #0055cc;
    }

    .footer-strongN {
        color: #9a5a00;
    }

    /* =========================================
       2. ESTRUCTURA PRINCIPAL
       ========================================= */
    .footer-web {
        background-color: #fff;
        padding: 1.2rem 2rem;
        width: 100%;
        box-sizing: border-box;
        margin-top: auto; 
    }

    .footer-container {
        max-width: 1300px;
        margin: 0 auto;
        display: flex;
        flex-direction: row; 
        justify-content: space-between;
        align-items: center; 
        gap: 4rem;
    }

    /* =========================================
       3. BLOQUE DE TEXTO (IZQUIERDA)
       ========================================= */
    .footer-info {
        flex: 1;
        text-align: left;
        color: #333;
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .footer-info p {
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .footer-info p:last-child {
        margin-bottom: 0;
    }

    /* =========================================
       4. BLOQUE DE IMÁGENES (DERECHA)
       ========================================= */
    .footer-logos {
        flex: 1.2; 
        display: flex;
        justify-content: center; 
        align-items: center;
        flex-wrap: wrap; 
        gap: 1.5rem;
        max-width: 500px; 
        margin-left: auto; 
    }

    .footer-logos img {
        height: 60px; 
        width: auto;
        object-fit: contain;
        filter: grayscale(20%);
        transition: filter 0.3s ease;
    }

    .footer-logos img:hover {
        filter: grayscale(0%);
    }

    /* =========================================
       5. RESPONSIVE
       ========================================= */
    @media (max-width: 965px) {
        .footer-container {
            flex-direction: column;
            gap: 2rem;
        }
        
        .footer-info {
            text-align: center;
        }

        .footer-logos {
            justify-content: center;
            margin-left: 0;
        }
    }
</style>