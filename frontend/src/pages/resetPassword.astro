---
// src/pages/reset-password.astro
import BaseLayout from '../layouts/BasePage.astro';
import { FormularioResetFinal } from '../components/sesiones/FormularioResetPassword';
import '../styles/sesiones.css'
import ImageBack from "../assets/background_Images/10_reserva.jpg";

// Capturamos los datos de la URL
const token = Astro.url.searchParams.get('token');
const email = Astro.url.searchParams.get('email');

// Si no hay token, redirigimos a login (intento de acceso directo ilegal)
if (!token || !email) {
  return Astro.redirect('/login');
}
---

<BaseLayout tituloPage="Nueva Contraseña" imageBack={ImageBack.src} centrado={true}>
    <div class="container-form">
        <h2>Restablecer Contraseña</h2>
        <p>
            Introduce tu nueva contraseña para la cuenta <strong>{email}</strong>
        </p>
        <FormularioResetFinal client:load token={token} email={email} />
    </div>
</BaseLayout>