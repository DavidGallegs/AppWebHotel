---
// src/pages/forgot-password.astro
import BaseLayout from '../layouts/BasePage.astro';
import { FormularioRecuperar } from '../components/sesiones/FormularioRecuperar';
import ImageBack from "../assets/background_Images/10_reserva.jpg";
import '../styles/sesiones.css'
---

<BaseLayout tituloPage="Recuperar Contraseña"  imageBack={ImageBack.src}  centrado={true}>
    <div class="auth-container">
        <h2 class="auth-title">¿Olvidaste tu contraseña?</h2>
        <p class="auth-subtitle">Introduce tu email y te enviaremos un enlace para restaurarla.</p>
        <FormularioRecuperar client:load />
    </div>
</BaseLayout>