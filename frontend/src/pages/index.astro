---
import BaseLayout from '../layouts/BasePage.astro';
import * as HomeData from '../md_pages/home.mdx';

const { Content, frontmatter } = HomeData;
---

<BaseLayout tituloPage={frontmatter.tituloPage} imageBack={frontmatter.imageBack}>
    
    <!-- 1. Solo el texto: esto mantiene el formato de párrafos y títulos -->
        <div class="bloque-texto">
            <Content />
        </div>

        <div class="bloque-imagenes">
            <img src="/1_home/pueblo.jpg" alt="Pueblo Taranes" />
            <img src="/1_home/monte_tiatordos.jpg" alt="Montaña tiratordos" />
            <img src="/1_home/casa_quintanal.jpg" alt="Casa Quintanal" />
            <img src="/1_home/habitacion.jpg" alt="Habitacion Taranes" />
            <img src="/1_home/cochinillo.jpg" alt="Cochinillo" />
            <img src="/1_home/asturias.jpg" alt="Asturias Taranes" />
        </div>


</BaseLayout>