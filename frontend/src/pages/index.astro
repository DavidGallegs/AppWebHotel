---
// src/pages/index.astro
import BaseLayout from '../layouts/BasePage.astro'; // Ajusta la ruta si es necesario

// 1. Importamos TODA la información de tu archivo home.mdx directamente
import * as HomeData from '../md_pages/home.mdx';

// 2. Extraemos el Componente del contenido y sus variables
const { Content, frontmatter } = HomeData;
---

<!-- 3. Usamos tu Layout pasándole las variables de tu home.mdx -->
<BaseLayout tituloPage={frontmatter.tituloPage} imageBack={frontmatter.imageBack}>
  <Content />
</BaseLayout>