---
export const prerender = false;
import BasePage from "../layouts/BasePage.astro";
import { getSession } from 'auth-astro/server';

import { DashboardApp } from '../components/dashboard/ReservationList';

const session = await getSession(Astro.request);
const token = (session?.user as any)?.token || "";
---

<BasePage tituloPage="Hotel Rural Taranes" centrado={true} imageBack="/background_Images/10_reservas.jpg">
  <DashboardApp client:load token={token} />
</BasePage>