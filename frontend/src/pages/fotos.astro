---
import BasePage from '../layouts/BasePage.astro';
import ImageBack from "../assets/background_Images/8_flor.jpg"
import '../styles/fotos.css'

/* * COMPONENTE: Galería de Fotos
 * Propósito: Muestra el catálogo visual de la casa rural. 
 * Los datos están centralizados en un array para que añadir fotos en el futuro 
 * solo sea copiar y pegar una línea, sin tocar el HTML.
 */
const galerias = [
  {
    titulo: "Hotel Rural de Montaña",
    fotos: [
      "/5_hotelRural/hab1_01.jpg", "/5_hotelRural/hab1_02.jpg", "/5_hotelRural/hab1_03.jpg", 
      "/5_hotelRural/hab1_04.jpg", "/5_hotelRural/hab1_05.jpg", "/5_hotelRural/hab1_06.jpg",
      "/5_hotelRural/hab1_07.jpg", "/5_hotelRural/hab1_08.jpg", "/5_hotelRural/hab1_09.jpg",
      "/5_hotelRural/hab1_11.jpg", "/5_hotelRural/hab1_12.jpg", "/5_hotelRural/hab1_13.jpg",
      "/5_hotelRural/hab1_14.jpg", "/5_hotelRural/hab1_15.jpg", "/5_hotelRural/hab1_16.jpg",
      "/5_hotelRural/hab1_17.jpg", "/5_hotelRural/hab1_18.jpg", "/5_hotelRural/hab1_19.jpg",
      "/5_hotelRural/hab1_20.jpg", "/5_hotelRural/hab1_21.jpg", "/5_hotelRural/hab1_22.jpg",
      "/5_hotelRural/hab1_23.jpg", "/5_hotelRural/hab2_01.jpg", "/5_hotelRural/hab2_02.jpg",
      "/5_hotelRural/hab2_03.jpg", "/5_hotelRural/hab2_04.jpg", "/5_hotelRural/hab2_05.jpg",
      "/5_hotelRural/hab2_06.jpg", "/5_hotelRural/hab2_07.jpg", "/5_hotelRural/hab2_08.jpg",
      "/5_hotelRural/hab2_09.jpg", "/5_hotelRural/hab2_10.jpg", "/5_hotelRural/hab2_11.jpg",
      "/5_hotelRural/hab2_12.jpg"
    ]
  },
  {
    titulo: "Bar",
    fotos: [
      "/6_bar/bar-1.jpg", "/6_bar/bar-2.jpg", "/6_bar/bar-3.jpg", "/6_bar/bar-4.jpg", 
      "/6_bar/bar-5.jpg", "/6_bar/bar-6.jpg", "/6_bar/bar-7.jpg", "/6_bar/bar-8.jpg", 
      "/6_bar/bar-9.jpg", "/6_bar/bar-10.jpg", "/6_bar/bar-11.jpg"
    ]
  },
  {
    titulo: "Taranes",
    fotos: [
      "/3_taranes/taranes-1.jpg", "/3_taranes/taranes-2.jpg", "/3_taranes/taranes-3.jpg",
      "/3_taranes/taranes-4.jpg", "/3_taranes/taranes-5.jpg", "/3_taranes/taranes-6.jpg",
      "/3_taranes/taranes-7.jpg", "/3_taranes/taranes-8.jpg", "/3_taranes/taranes-9.jpg",
      "/3_taranes/taranes-10.jpg"
    ]
  },
  {
    titulo: "Concejo y Parque Natural de Ponga",
    fotos: [
      "/4_ponga/ponga-1.jpg", "/4_ponga/ponga-2.jpg", "/4_ponga/ponga-3.jpg",
      "/4_ponga/ponga-4.jpg", "/4_ponga/ponga-5.jpg", "/4_ponga/ponga-6.jpg",
      "/4_ponga/ponga-7.jpg", "/4_ponga/ponga-8.jpg", "/4_ponga/ponga-9.jpg",
      "/4_ponga/ponga-10.jpg", "/4_ponga/ponga-11.jpg", "/4_ponga/ponga-12.jpg"
    ]
  }
];

const tituloPage = "Galería de Fotos";
---

<BasePage tituloPage={tituloPage} imageBack={ImageBack.src} centrado={true}>
  
  {/* ACCESIBILIDAD: Vinculamos la sección entera a su título principal */}
  <section class="galeria-container" aria-labelledby="titulo-principal-galeria">
    <h1 id="titulo-principal-galeria" class="main-title">Fotos</h1>

    {galerias.map((seccion, index) => (
      <div class="seccion-galeria" aria-labelledby={`titulo-seccion-${index}`}>
        <h2 id={`titulo-seccion-${index}`} class="titulo-seccion">{seccion.titulo}</h2>
        
        {/* Usamos role="list" para que los lectores de pantalla anuncien que esto es una agrupación de elementos */}
        <div class="grid-fotos" role="list">
          {seccion.fotos.map((src, fotoIndex) => (
            <div class="foto-card" role="listitem">
              {/* loading="lazy" retrasa la carga hasta que el usuario hace scroll, ahorrando datos y tiempo */}
              <img 
                src={src} 
                alt={`Fotografía ${fotoIndex + 1} de la sección ${seccion.titulo}`} 
                loading="lazy" 
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

</BasePage>