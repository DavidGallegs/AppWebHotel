---
import Navigation from "../components/BasePage/Navigation.astro";
import Footer from "../components/BasePage/footer.astro"
import '../styles/global.css'; 
import '../styles/baseAstro.css';

// 1. Añadimos la variable "centrado" y le damos el valor "false" por defecto
const { tituloPage, imageBack, centrado = false } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{tituloPage}</title>
    </head>
    
    <body>
        <div class="fondo-hero" style={`background-image: url('${imageBack}');`}></div>
        
        <div style="height: 85px; width: 100%;"></div>

        <Navigation />
        
        <!-- 2. MAGIA: Si centrado es true, pone la clase 'modo-centrado', si no, 'modo-derecha' -->
        <main class={`contenedor-torre ${centrado ? 'modo-centrado' : 'modo-derecha'}`}>
            <div class="bloque-texto">
                <slot />
            </div>

        </main>
        <Footer/>
    </body>
</html>