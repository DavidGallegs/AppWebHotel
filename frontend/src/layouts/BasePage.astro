---
import Navigation from "../components/BasePage/Navigation.astro";
import Footer from "../components/BasePage/Footer.astro"
import '../styles/global.css'; 
import '../styles/baseAstro.css';

// MAGIA 2: Comprobamos si las variables vienen dentro de "frontmatter" (porque es un MDX) 
// o si vienen directamente en Astro.props (porque es un archivo .astro)
const props = Astro.props.frontmatter || Astro.props;

// Ahora sí extraemos las variables de forma segura
const { tituloPage, imageBack, centrado = false } = props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{tituloPage}</title>
    </head>
    
    <body>
        <div class="fondo-hero" style={`background-image: url('${imageBack}');`}></div>
        
        <div style="height: 85px; width: 100%;"></div>

        <Navigation />
        
        <!-- 2. MAGIA: Si centrado es true, pone la clase 'modo-centrado', si no, 'modo-derecha' -->
        <main class={`contenedor-torre ${centrado ? 'modo-centrado' : 'modo-derecha'}`}>
    
            <div class="bloque-texto">
                <slot />
            </div>

            <slot name="contenido-libre" />

        </main>
        <Footer/>
    </body>
</html>